#!/bin/bash
set -euo pipefail

# Log the upper-triangle flags and requested accuracy, including the retry.
read -r nstate
read -r -a pairs
[[ -f eh_state.dat && ! -e state.dat ]]
printf 'nac %s %s %s %s %s\n' "$1" "$2" "$3" "$nstate" "${pairs[*]}" >> requests.dat

fixture="$(dirname "$0")/nacm.dat.fixture"
if [[ $1 == 1 && $3 == 7 ]]; then
   # A truncated result must trigger a retry at the lower accuracy.
   head -n 2 "$fixture" > nacm.dat
else
   cp "$fixture" nacm.dat
fi
